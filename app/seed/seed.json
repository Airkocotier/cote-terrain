[{"kind": "exercise", "item": {"id": "defense-basse-coupelles", "title": "Défense basse en fente avec coupelles", "theme": "Défense basse en zone 5 : diagonale et ligne", "objectives": "Garder une posture de défense basse, mains basses et écartées, et aller chercher le ballon en fente latérale sans se relever, sur attaque en grande diagonale (poste 4) puis en ligne (poste 2).", "runInstructions": "L'entraîneur est toujours de l'autre côté du filet, debout sur un banc : tous les ballons partent de lui.\nLe défenseur tient une coupelle (plot plat) dans chaque main et se place en position basse en zone 5.\nSérie 1 : 10 attaques depuis le banc du poste 4, en grande diagonale.\nSérie 2 : l'entraîneur passe sur le banc du poste 2 et fait 10 attaques le long de la ligne.\nÀ chaque ballon, le défenseur part en fente, défend vers la zone 2-3 et pose une coupelle au point le plus loin atteint, puis revient en position.", "evolution": "1. Ballons lancés à la main, à vitesse moyenne.\n2. Attaques plus fortes, devant, à gauche ou à droite du défenseur.\n3. Sans coupelles : comparer la posture.\n4. Introduction du passeur en zone 2-3 : il joue la défense et fait une passe haute en poste 4.\n5. Introduction du libéro en zone 6 : il couvre l'arrière et défend les ballons qui passent derrière le défenseur.", "executionInstructions": "Mains basses et loin du corps grâce aux coupelles (interdit de poser les mains sur les genoux).\nRester bas : le centre de gravité ne remonte pas pendant le déplacement.\nPremier pas du côté du ballon, fente longue, genou au-dessus du pied.\nSur la ligne : rester à l'intérieur du terrain, épaule extérieure fermée pour garder le ballon dans le terrain.\nPlan de frappe orienté vers la zone 2-3 avant le contact.", "remarks": "Prévoir deux bancs stables (postes 4 et 2) et un chariot plein près de l'entraîneur.\nAvec plusieurs joueurs : un défenseur par série de 10, les autres ramassent les ballons et remettent les coupelles en place.", "coachRole": "Toujours derrière le filet, debout sur un banc : tous les ballons partent de lui. 10 attaques depuis le poste 4 en grande diagonale, puis il passe sur le banc du poste 2 pour 10 attaques en ligne. Il varie la longueur, la vitesse et le placement par rapport au défenseur, et corrige la posture (hanches, mains basses, épaule côté ligne) entre les séries.", "durationMin": 15, "playersCount": "1 défenseur (+ passeur et libéro en évolution)", "tags": ["Défense", "Physique"], "diagram": [{"type": "player", "id": "dc-e", "pos": {"x": 0.7385, "y": 0.0556}, "team": "COACH", "label": "E", "role": "NONE"}, {"type": "equipment", "id": "dc-cart", "pos": {"x": 0.5, "y": 0.0556}, "kind": "CART", "rotation": 0.0}, {"type": "text", "id": "dc-t4", "pos": {"x": 0.7385, "y": 0.1778}, "text": "banc poste 4"}, {"type": "text", "id": "dc-t2", "pos": {"x": 0.2615, "y": 0.1778}, "text": "banc poste 2"}, {"type": "player", "id": "dc-def", "pos": {"x": 0.2923, "y": 0.6593}, "team": "A", "label": "1", "role": "NONE"}, {"type": "arrow", "id": "dc-a1", "start": {"x": 0.7154, "y": 0.0963}, "end": {"x": 0.3538, "y": 0.6741}, "kind": "BALL", "control": {"x": 0.5692, "y": 0.3259}}, {"type": "arrow", "id": "dc-m1", "start": {"x": 0.3231, "y": 0.6667}, "end": {"x": 0.3462, "y": 0.6815}, "kind": "MOVE", "control": null}, {"type": "text", "id": "dc-tx1", "pos": {"x": 0.5692, "y": 0.4667}, "text": "10 × grande diagonale"}, {"type": "text", "id": "dc-tx0", "pos": {"x": 0.2923, "y": 0.7704}, "text": "1 coupelle / main"}], "phases": [{"id": "dc-p1", "name": "Série 1 : diagonale (poste 4)", "elements": [{"type": "player", "id": "dc-e", "pos": {"x": 0.7385, "y": 0.0556}, "team": "COACH", "label": "E", "role": "NONE"}, {"type": "equipment", "id": "dc-cart", "pos": {"x": 0.5, "y": 0.0556}, "kind": "CART", "rotation": 0.0}, {"type": "text", "id": "dc-t4", "pos": {"x": 0.7385, "y": 0.1778}, "text": "banc poste 4"}, {"type": "text", "id": "dc-t2", "pos": {"x": 0.2615, "y": 0.1778}, "text": "banc poste 2"}, {"type": "play